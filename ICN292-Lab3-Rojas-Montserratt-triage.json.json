      "id": "45c9b1af-f030-434c-8a58-4ab4e4125618",
      "name": "Respond to Webhook"
    },
    {
      "parameters": {
        "jsCode": "// 1. Tomar los datos originales que entraron por el Webhook\nconst body = $('Webhook').first().json.body;\n\n// 2. Tomar el valor de la UF desde la API\nconst uf = $('Consulta API UF').first().json.uf.valor;\n\n// 3. Revisar de forma segura cuál de las 4 rutas corrió\nconst rutas = ['Set Datos Invalidos', 'Set Rechazo', 'Set Revision', 'Set Aprobacion'];\nlet datosRuta = { ruta: 'DESCONOCIDO', motivo: 'SIN_MOTIVO' };\n\nfor (const nombre of rutas) {\n  try {\n    const nodo = $(nombre);\n    if (nodo && nodo.isExecuted) {\n      datosRuta = nodo.first().json;\n      break;\n    }\n  } catch (e) {\n    // Si el nodo no corrió, no arroja error, simplemente pasa al siguiente\n  }\n}\n\n// 4. Calcular el monto en UF\nconst montoCLP = Number(body.monto);\nconst montoUF = (montoCLP / Number(uf)).toFixed(2);\n\n// 5. Entregar el resultado completo\nreturn [{\n  json: {\n    id_solicitud: body.id_solicitud,\n    sku: body.sku,\n    monto_clp: montoCLP,\n    monto_uf: montoUF,\n    ruta: datosRuta.ruta,\n    motivo: datosRuta.motivo,\n    param_U: 46000,\n    param_D: 21,\n    mensaje_cliente: `Estimado cliente, su solicitud ${body.id_solicitud} ha sido catalogada en estado: ${datosRuta.ruta}`\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
